{
  "name": "mark-tini",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "description": "Mark Tini - Offline document converter with faithful PDF-to-Word export",
  "author": "DHSystem",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:electron": "vite",
    "test:e2e": "npm run build && playwright test",
    "prepare:offline": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/prepare-offline-bundle.ps1",
    "validate:offline": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/prepare-offline-bundle.ps1 -ValidateOnly",
    "build:electron": "npm run prepare:offline && tsc -b && vite build && electron-builder"
  },
  "build": {
    "publish": {
      "provider": "github",
      "owner": "danghoangsqtt-sys",
      "repo": "dhsystem_mdconverter"
    },
    "appId": "com.dhsystem.marktini",
    "productName": "Mark Tini",
    "copyright": "Copyright © 2026 DHSystem",
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icons/tini-suite.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "build/icons/tini-suite.ico",
      "uninstallerIcon": "build/icons/tini-suite.ico"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../python_runtime",
        "to": "python_runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../offline_models",
        "to": "offline_models",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "@uiw/react-md-editor": "^4.1.0",
    "autoprefixer": "^10.5.0",
    "axios": "^1.16.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.16.0",
    "pdfjs-dist": "5.4.296",
    "postcss": "^8.5.14",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-pdf": "^10.4.1",
    "rehype-sanitize": "^6.0.0",
    "tailwindcss": "3.4.17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "agentation": "^3.0.2",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7"
  }
}
