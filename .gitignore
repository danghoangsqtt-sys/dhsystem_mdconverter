# Build outputs
frontend/dist/
frontend/dist-electron/
frontend/release/
dist-electron/

# One-off / manual electron-builder output and backup snapshots created
# outside the standard `release/` path during local packaging tests.
frontend/dist-release/
frontend/release-candidate-*/
frontend/release-sandbox-backup-*/
frontend/test-results-sandbox-backup-*/

# Playwright e2e test artifacts (screenshots, traces, error contexts)
frontend/test-results/
frontend/playwright-report/

# Dependencies
node_modules/

# Python cache
__pycache__/
*.pyc

# Environment
docling-env/
python_runtime/
offline_models/
.env

# Runtime data: uploaded source files, generated markdown output,
# conversion history, and rotated log files. Created automatically by the
# backend on startup (see main.py); never meant to be committed.
data/uploads/
data/outputs/
data/history.json
data/logs/
